# ── Device identity (Home Assistant discovery) ──
MQTT_IDENTIFIER=gardyn_03
MQTT_BASETOPIC=gardyn
MQTT_DEVICE_MODEL="gardyn 3.0"
MQTT_VERSION="1.0.0"

# ── MQTT broker ──
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=gardyn
MQTT_PASSWORD=somepassword
MQTT_KEEPALIVE_INTERVAL=60

# ── Logging ──
LOG_LEVEL=INFO
LOG_FILE=gardyn.log

# ── pigpio connection ──
# Leave PIGPIO_HOST unset for local pigpiod. For Docker, point at the
# pigpiod container, e.g. PIGPIO_HOST=pigpiod / PIGPIO_PORT=8888.
#PIGPIO_HOST=
PIGPIO_PORT=8888

# ── Hardware model / sensors ──
# SENSOR_TYPE is auto-detected by bin/setup.sh (AM2320 or DHT20).
# GARDYN_MODEL forces a model instead of runtime auto-detection.
#GARDYN_MODEL=

# ── GPIO pins (BCM) ──
LIGHT_PIN=18
LIGHT_FREQUENCY=8000
PUMP_PIN=24
PUMP_FREQUENCY=50
DISTANCE_ECHO_PIN=19
DISTANCE_TRIGGER_PIN=26
BUTTON_PIN=13
OVER_TEMP_ALERT_PIN=25
DEFAULT_BRIGHTNESS=50
DEFAULT_PUMP_SPEED=100

# ── I2C addresses (decimal or 0x hex) ──
PCB_TEMP_ADDRESS=0x48
INA219_ADDRESS=0x40
OVER_TEMP_HIGH=36
OVER_TEMP_HYSTERESIS=34

# ── Water level alert ──
# Distance (cm) above which the tank is "low". 0 disables.
WATER_LOW_CM=11

# ── Camera ──
UPPER_CAMERA_DEVICE=/dev/video0
LOWER_CAMERA_DEVICE=/dev/video2
UPPER_IMAGE_PATH=/tmp/upper_camera.jpg
LOWER_IMAGE_PATH=/tmp/lower_camera.jpg
CAMERA_RESOLUTION="640x480"
IMAGE_INTERVAL_SECONDS=3600

# ── REST API auth (optional) ──
# When set, non-localhost requests must send X-API-Key: <key>.
#GARDEN_API_KEY=

# ── State persistence ──
STATE_FILE=~/.garden_state.json
SCHEDULE_FILE=~/.garden_schedule.json
GROW_STATE_FILE=~/.garden_grow.json

# ── Grow-cycle reminders (days; 0 disables) ──
THINNING_REMINDER_DAYS=14
ROOT_CHECK_REMINDER_DAYS=21
HARVEST_REMINDER_DAYS=35
NUTRIENT_REMINDER_DAYS=7

# ── External integrations (scaffolded) ──
ALEXA_ENABLED=false
THINGSBOARD_ENABLED=false
THINGSBOARD_HOST=
THINGSBOARD_TOKEN=
TELEGRAF_ENABLED=false
